{
  "name": "pathforge",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned pathology reporting domain and delivery dashboard",
  "type": "module",
  "scripts": {
    "start": "node scripts/task-dashboard.mjs",
    "dashboard": "node scripts/task-dashboard.mjs",
    "format": "biome format --write src test/domain",
    "format:check": "biome format src test/domain",
    "lint": "biome lint scripts src test",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "node --test",
    "fixtures:check": "node --test test/domain/fixtures.test.mjs",
    "tasks:check": "node scripts/task-dashboard.mjs --check",
    "test": "npm run test:unit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run fixtures:check && npm run tasks:check",
    "build": "npm run typecheck"
  },
  "engines": {
    "node": "24.20.0",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
