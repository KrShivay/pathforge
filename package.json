{
  "name": "pathforge",
  "version": "0.1.0",
  "private": true,
  "description": "Small clinical-pathology report preview and PDF-printing prototype",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "format": "biome format --write scripts src test",
    "format:check": "biome format scripts src test",
    "lint": "biome lint scripts src test && npm run lint:tsx",
    "lint:tsx": "oxlint -c .oxlintrc.json src",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:app": "tsc --project tsconfig.app.json --noEmit",
    "test:unit": "node --test",
    "fixtures:check": "node --test test/domain/fixtures.test.mjs",
    "test": "npm run test:unit",
    "css:check": "node scripts/check-css-integrity.mjs",
    "verify": "npm run format:check && npm run lint && npm run css:check && npm run typecheck && npm run typecheck:app && npm run test:unit && npm run fixtures:check",
    "build": "vite build",
    "build:web": "vite build --mode github-pages"
  },
  "engines": {
    "node": "24.20.0",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "24.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^0.15.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.11",
    "@mui/x-date-pickers": "^9.13.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.42.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sweetalert2": "^11.26.25"
  }
}
