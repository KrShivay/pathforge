{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PathForge",
  "version": "0.1.0",
  "identifier": "com.pathforge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PathForge",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"]
  }
}
